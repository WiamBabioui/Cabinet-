# ================================
# Environment de Test Cabinet+
# ================================
# Copier ce fichier en .env.test et adapter si nécessaire

# ================================
# MongoDB (local ou test Atlas)
# ================================
MONGO_URI=mongodb://localhost:27017/cabinet_plus_test

# ================================
# MySQL (même DB que dev — les tests nettoient après eux)
# ================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cabinet_plus
DB_PORT=3306

# ================================
# JWT (secret dédié au test)
# ================================
JWT_SECRET=cabinet_plus_test_secret_2024_jest
JWT_EXPIRES_IN=1h

# ================================
# Serveur
# ================================
PORT=5001
NODE_ENV=test

# ================================
# Frontend URL (tests de déploiement)
# ================================
CLIENT_URL=http://localhost:5173

# ================================
# URLs Production (laisser vide en local — définir en CI/CD)
# ================================
# BACKEND_URL=https://cabinet-plus-backend.onrender.com
# FRONTEND_URL=https://cabinet-plus-frontend.onrender.com
